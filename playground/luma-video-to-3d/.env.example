# Get a key at https://lumalabs.ai/dream-machine/api/keys
LUMAAI_API_KEY=luma-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional: a publicly reachable HTTPS base URL for THIS server, so Luma can
# fetch the uploaded keyframe. Set this if you're tunneling with ngrok or
# running behind a reverse proxy. Leave empty when deployed somewhere with a
# real public URL — the server will infer it from request headers.
# PUBLIC_URL=https://your-tunnel.ngrok.app

# PORT=3000
